# Plantilla de variables de entorno del stack v0.
# Copiá este archivo a .env (gitignored) y completá los valores localmente.
# El .env real nunca se committea — la URL del AVL upstream se trata como secret
# (per spec bridge-gtfs-rt R-03; en CI se inyecta desde un GitHub Secret homónimo).

# URL del AVL upstream del operador.
# - Local: pegar la URL real acá.
# - CI: viene de `${{ secrets.ORIGIN_AVL }}` solo cuando el workflow lo necesita.
# - Smoke offline: `file:///app/test/fixtures/avl-sample.xml` (path absoluto
#   dentro del container) para que el poll lea del fixture committeado.
ORIGIN_AVL=

# Intervalo de poll en ms. Default 30 000 (per design D-06).
POLL_INTERVAL_MS=30000

# Puerto interno del bridge dentro de la red Docker. Default 3001 (per
# spec R-01 + contrato de R-05 de otp-routing).
BRIDGE_PORT=3001

# Puerto público del viewer (Next.js app + API routes). Único service del
# stack con host port mapping per spec viewer-shell-and-api R-01.
VIEWER_PORT=8080

# URLs internas a OTP y al bridge — usadas por el viewer para traducir
# GraphQL queries y decodear .pb (per spec viewer-shell-and-api R-04 / R-08).
OTP_BASE_URL=http://otp:8080
BRIDGE_BASE_URL=http://bridge:3001

# CORS opcional. Vacío por default (same-origin). Si el viewer dev server
# corre en otro puerto (ej. localhost:3000), setear acá la lista CSV de
# orígenes permitidos. Per spec viewer-shell-and-api R-11.
VIEWER_CORS_ORIGINS=

# Google Maps JS API key — el canvas del modo OD (per viewer-od-mode R-02).
# La key se bundlea al cliente por el prefijo NEXT_PUBLIC_*; la seguridad
# se enforza con HTTP referrer restriction en la GCP Console (lista blanca
# con el dominio del demo + localhost). Sin esta var, el viewer renderiza
# un banner explícito de "falta la API key" en lugar del mapa — no rompe
# la chrome ni los endpoints /api/*.
#   GCP referrer docs: https://developers.google.com/maps/api-security-best-practices
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Override opcional del centro del mapa (lat,lon). Default: Colonia urbano.
NEXT_PUBLIC_VIEWER_DEFAULT_CENTER=-34.467,-57.840
